{
  "info": {
    "name": "WBAPI - Test Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"username\": \"admin\", \"password\": \"password\" }"
        },
        "url": {
          "raw": "https://localhost:7149/api/auth/login",
          "host": ["https://localhost:7149"],
          "path": ["api", "auth", "login"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.environment.set(\"jwt\", json.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get products (no auth) - should 401",
      "request": {
        "method": "GET",
        "url": {
          "raw": "https://localhost:7149/api/products",
          "host": ["https://localhost:7149"],
          "path": ["api", "products"]
        }
      }
    },
    {
      "name": "Get products (with token)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "url": {
          "raw": "https://localhost:7149/api/products",
          "host": ["https://localhost:7149"],
          "path": ["api", "products"]
        }
      }
    },
    {
      "name": "Create product",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"name\": \"New product\", \"price\": 12.5 }"
        },
        "url": {
          "raw": "https://localhost:7149/api/products",
          "host": ["https://localhost:7149"],
          "path": ["api", "products"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.environment.set(\"createdId\", json.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get created product",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "url": {
          "raw": "https://localhost:7149/api/products/{{createdId}}",
          "host": ["https://localhost:7149"],
          "path": ["api", "products", "{{createdId}}"]
        }
      }
    },
    {
      "name": "Update product",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"name\": \"Updated name\", \"price\": 20 }"
        },
        "url": {
          "raw": "https://localhost:7149/api/products/{{createdId}}",
          "host": ["https://localhost:7149"],
          "path": ["api", "products", "{{createdId}}"]
        }
      }
    },
    {
      "name": "Delete product",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "url": {
          "raw": "https://localhost:7149/api/products/{{createdId}}",
          "host": ["https://localhost:7149"],
          "path": ["api", "products", "{{createdId}}"]
        }
      }
    }
  ]
}
